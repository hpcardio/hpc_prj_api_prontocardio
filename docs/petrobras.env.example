# API: inject secrets securely; never commit populated values.
PETROBRAS_ENABLED=false
PETROBRAS_TRANSMISSION_ENABLED=false
# Pilot: comma-separated e-mails allowed to transmit; empty = every writer.
PETROBRAS_TRANSMISSION_USERS=
# Appeal operator 4-digit denial codes (3209, 3253...) outside dm_tipoGlosa.
PETROBRAS_APPEAL_OPERATOR_CODES=false
PETROBRAS_LOGIN=
PETROBRAS_PASSWORD=
PETROBRAS_PRESTADOR_CNPJ=
# Code registered by the operator; defaults to the CNPJ value as a code.
PETROBRAS_CODIGO_PRESTADOR=
PETROBRAS_REGISTRO_ANS=422631
PETROBRAS_CONVENIO_ID=37
PETROBRAS_ORACLE_GUIA=guia_prestador
PETROBRAS_DISCOVERY_MONTHS=3
PETROBRAS_INTERVAL_MINUTES=360
PETROBRAS_TIMEOUT_SECONDS=30
PETROBRAS_MAX_ATTACHMENT_BYTES=5242880
# Portal Saúde Petrobras (read-only): account analysis of guide-only lots.
PETROBRAS_PORTAL_LOGIN=
PETROBRAS_PORTAL_PASSWORD=
# Frontend: PETROBRAS_ENABLED=false (enable only after API + migration).
